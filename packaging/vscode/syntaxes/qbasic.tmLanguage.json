{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "QBNex BASIC",
  "scopeName": "source.qbasic",
  "fileTypes": [
    "bas",
    "bi",
    "bm"
  ],
  "patterns": [
    {
      "include": "#metacomment"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#metacommand"
    },
    {
      "include": "#string"
    },
    {
      "include": "#line-start"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#identifier"
    }
  ],
  "repository": {
    "metacomment": {
      "patterns": [
        {
          "name": "meta.preprocessor.metacomment.qbasic",
          "match": "(?i)('|(?<![\\w.])REM(?![\\w.]))\\s*(\\$[A-Za-z_]+)(.*)$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.qbasic"
            },
            "2": {
              "name": "keyword.control.directive.qbasic"
            },
            "3": {
              "name": "string.unquoted.directive.qbasic"
            }
          }
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.qbasic",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.qbasic",
          "match": "(?i)(?<![\\w.])REM(?![\\w.]).*$"
        },
        {
          "name": "comment.line.number-sign.qbasic",
          "match": "^\\s*#(?=\\s|$|!).*$"
        }
      ]
    },
    "metacommand": {
      "patterns": [
        {
          "name": "meta.preprocessor.qbasic",
          "match": "^\\s*(\\$[A-Za-z_]\\w*)(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.directive.qbasic"
            },
            "2": {
              "name": "string.unquoted.directive.qbasic"
            }
          }
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.qbasic",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.qbasic"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.qbasic"
            }
          }
        }
      ]
    },
    "line-start": {
      "patterns": [
        {
          "name": "entity.name.label.line-number.qbasic",
          "match": "^\\s*\\d+(?=\\s|$|:|')"
        },
        {
          "match": "(?i)^\\s*(?!(?<![\\w.$])(?:_CONNECTIONADDRESS|_TOTALDROPPEDFILES|_ALLOWFULLSCREEN|_BACKGROUNDCOLOR|_ACCEPTFILEDROP|_CLIPBOARDIMAGE|_INCLERRORFILE\\$|_MOUSEINPUTPIPE|_MOUSEMOVEMENTX|_MOUSEMOVEMENTY|_MOUSEPIPECLOSE|_OPENCONNECTION|_WINDOWHASFOCUS|_CONSOLECURSOR|_DESKTOPHEIGHT|_ERRORMESSAGE\\$|_INCLERRORLINE|_MOUSEPIPEOPEN|_BUTTONCHANGE|_COMMANDCOUNT|_CONSOLEINPUT|_CONSOLETITLE|_DEFAULTCOLOR|_DESKTOPWIDTH|_DISPLAYORDER|_ENVIRONCOUNT|_MESHTRIANGLE|_PALETTECOLOR|_RESIZEHEIGHT|_SCALEDHEIGHT|_SCREENEXISTS|_SHADERERROR\\$|_WINDOWHANDLE|_AUTODISPLAY|_CAMERAORTHO|_CAMERARANGE|_CONSOLEFONT|_COPYPALETTE|_DEPTHBUFFER|_DEVICEINPUT|_DIRECTIONAL|_DROPPEDFILE|_MAPTRIANGLE|_MESHTEXTURE|_MOUSEBUTTON|_PRINTSTRING|_RESIZEWIDTH|_SCALEDWIDTH|_SCREENCLICK|_SCREENIMAGE|_SCREENPRINT|_SHADERPARAM|_SNDPLAYCOPY|_SNDPLAYFILE|_CLEARCOLOR|_CLIPBOARD\\$|_CONTROLCHR|_FILEEXISTS|_FINISHDROP|_FONTHEIGHT|_FREESHADER|_FULLSCREEN|_LASTBUTTON|_MAPUNICODE|_MEMELEMENT|_MESHSHADER|_MESHVERTEX|_MOUSEINPUT|_MOUSEWHEEL|_OPENCLIENT|_PRINTIMAGE|_PRINTWIDTH|_RANDOMSEED|_SCREENHIDE|_SCREENICON|_SCREENMOVE|_SCREENSHOW|_SCROLLLOCK|_SNDOPENRAW|_SNDPLAYING|_SNDRAWDONE|_STARTSWITH|CUSTOMTYPE|IMPLEMENTS|_CONNECTED|_COPYIMAGE|_DIREXISTS|_DONTBLEND|_ERRORLINE|_FONTWIDTH|_FREEIMAGE|_FREELIGHT|_FREETIMER|_INTEGER64|_LASTWHEEL|_LOADIMAGE|_LOADMODEL|_MEMEXISTS|_MESHBEGIN|_MESHCOLOR|_MESHPLANE|_MOUSEHIDE|_MOUSEMOVE|_MOUSESHOW|_PIXELSIZE|_PRINTMODE|_SHELLHIDE|_SNDGETPOS|_SNDPAUSED|_SNDRAWLEN|_SNDSETPOS|_STARTDIR\\$|_TOGGLEBIT|RANDOMIZE|_CAPSLOCK|_CONTINUE|_DEFLATE\\$|_ENDSWITH|_EXPLICIT|_FREEFONT|_FREEMESH|_GLRENDER|_INFLATE\\$|_INSTRREV|_KEYCLEAR|_LASTAXIS|_LOADFONT|_MEMIMAGE|_MEMSOUND|_MESHCUBE|_NEWIMAGE|_OPENHOST|_PRESERVE|_PUTIMAGE|_REPLACE\\$|_RESETBIT|_SETALPHA|_SNDCLOSE|_SNDLIMIT|_SNDPAUSE|_UNSIGNED|COMMAND\\$|ENVIRON\\$|EXPLICIT|FILEATTR|FREEFILE|FUNCTION|OPTIONAL|PRESERVE|_ALPHA32|_AMBIENT|_ANDALSO|_CLEAR3D|_CONSOLE|_DEVICE\\$|_DEVICES|_DISPLAY|_FORMAT\\$|_GREEN32|_KEYDOWN|_LIGHTON|_MEMCOPY|_MEMFILL|_MEMFREE|_MESHEND|_NUMLOCK|_READBIT|_SCREENX|_SCREENY|_SNDCOPY|_SNDLOOP|_SNDOPEN|_SNDPLAY|_SNDRATE|_SNDSTOP|_STRICMP|DECLARE|DYNAMIC|EXTENDS|FINALLY|INTEGER|LIBRARY|MKDMBF\\$|MKSMBF\\$|PALETTE|RESTORE|STRING\\$|VARPTR\\$|_ARCCOT|_ARCCSC|_ARCSEC|_ASSERT|_BLUE32|_BUTTON|_CAMERA|_DRAW3D|_HEIGHT|_KEYHIT|_MEMGET|_MEMNEW|_MEMPUT|_MOUSEX|_MOUSEY|_OFFSET|_ORELSE|_RESIZE|_RGBA32|_SETBIT|_SHADER|_SMOOTH|_SNDBAL|_SNDLEN|_SNDRAW|_SNDVOL|_SOURCE|_STDERR|_STRCMP|_TITLE\\$|_TOSTR\\$|ACCESS|APPEND|BINARY|CIRCLE|COMMON|CSRLIN|CVDMBF|CVSMBF|DEFDBL|DEFINT|DEFLNG|DEFSNG|DEFSTR|DOUBLE|ELSEIF|IMPORT|INKEY\\$|INPUT\\$|LBOUND|LCASE\\$|LOCATE|LPRINT|LTRIM\\$|OPTION|OUTPUT|PRESET|RANDOM|RESUME|RETURN|RIGHT\\$|RTRIM\\$|SCREEN|SELECT|SETMEM|SHARED|SINGLE|SPACE\\$|STATIC|STRING|SYSTEM|UBOUND|UCASE\\$|UEVENT|UNLOCK|VARSEG|WINDOW|_ACOSH|_ALPHA|_ASINH|_ATAN2|_ATANH|_BLEND|_BLINK|_DELAY|_FLOAT|_GPU3D|_GREEN|_HYPOT|_JOIN\\$|_LIGHT|_LIMIT|_ORTHO|_POINT|_RED32|_REGEX|_RGB32|_ROUND|_SPLIT|_THROW|_TRIM\\$|_UCHR\\$|_UMID\\$|_VOICE|_WHEEL|_WIDTH|ALIAS|BLOAD|BSAVE|BYVAL|CATCH|CHAIN|CHDIR|CLASS|CLEAR|CLOSE|COLOR|CONST|DATE\\$|ENDIF|ERASE|ERROR|FILES|GOSUB|INPUT|INSTR|IOCTL|LEFT\\$|MKDIR|PAINT|PCOPY|POINT|PRINT|REDIM|RESET|RMDIR|SHELL|SLEEP|SOUND|STICK|STRIG|TIME\\$|TIMER|TROFF|UNTIL|USING|WHILE|WIDTH|WRITE|_ACOS|_ADSR|_ASIN|_AXIS|_BIN\\$|_BLUE|_BYTE|_CEIL|_CINP|_COSH|_COTH|_CSCH|_CWD\\$|_DEST|_DICT|_DIR\\$|_ECHO|_EXIT|_FONT|_ICON|_LIST|_MESH|_RGBA|_SECH|_SINH|_TANH|_UASC|_ULEN|_WAVE|BASE|BEEP|CALL|CASE|CDBL|CHR\\$|CINT|CLNG|CSNG|DATA|DRAW|EACH|ELSE|ENUM|EXIT|GOTO|HEX\\$|KILL|LINE|LOCK|LONG|LOOP|LPOS|LSET|MID\\$|MKD\\$|MKI\\$|MKL\\$|MKS\\$|NAME|NEXT|OCT\\$|OPEN|PEEK|PLAY|PMAP|POKE|PSET|READ|RSET|SADD|SEEK|STEP|STOP|STR\\$|SWAP|THEN|TRON|TYPE|VIEW|WAIT|WEND|_BIT|_COT|_CSC|_D2G|_D2R|_FPS|_G2D|_G2R|_IIF|_MEM|_MK\\$|_OS\\$|_R2D|_R2G|_RED|_RGB|_SEC|_SHL|_SHR|ABS|AND|ANY|ASC|ATN|CLS|COM|COS|CVD|CVI|CVL|CVS|DEF|DIM|END|EOF|EQV|ERL|ERR|EXP|FIX|FOR|FRE|GET|IMP|INP|INT|KEY|LEN|LET|LOC|LOF|LOG|MOD|NOT|OFF|OUT|PEN|POS|PUT|REM|RND|SEG|SGN|SIN|SPC|SQR|SUB|TAB|TAN|TRY|VAL|XOR|_CV|_PI|AS|DO|FN|IF|IN|IS|ON|OR|TO)(?![\\w.$%&!#~`])\\s*:)([A-Za-z_][\\w]*)(:)(?!=)",
          "captures": {
            "1": {
              "name": "entity.name.label.qbasic"
            },
            "2": {
              "name": "punctuation.separator.label.qbasic"
            }
          }
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "match": "(?i)(?<![\\w.])(DECLARE\\s+)?(SUB|FUNCTION)\\s+([A-Za-z_][\\w.]*[%&!#$~`]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.qbasic"
            },
            "2": {
              "name": "storage.type.function.qbasic"
            },
            "3": {
              "name": "entity.name.function.qbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w.])(DEF)\\s+(FN[A-Za-z_][\\w.]*[%&!#$~`]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.qbasic"
            },
            "2": {
              "name": "entity.name.function.qbasic"
            }
          }
        },
        {
          "match": "(?i)^\\s*(TYPE|CLASS|ENUM)\\s+([A-Za-z_][\\w.]*[%&!#$~`]*)",
          "captures": {
            "1": {
              "name": "storage.type.qbasic"
            },
            "2": {
              "name": "entity.name.type.qbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w.])(AS)\\s+(?!(?<![\\w.$])(?:_CONNECTIONADDRESS|_TOTALDROPPEDFILES|_ALLOWFULLSCREEN|_BACKGROUNDCOLOR|_ACCEPTFILEDROP|_CLIPBOARDIMAGE|_INCLERRORFILE\\$|_MOUSEINPUTPIPE|_MOUSEMOVEMENTX|_MOUSEMOVEMENTY|_MOUSEPIPECLOSE|_OPENCONNECTION|_WINDOWHASFOCUS|_CONSOLECURSOR|_DESKTOPHEIGHT|_ERRORMESSAGE\\$|_INCLERRORLINE|_MOUSEPIPEOPEN|_BUTTONCHANGE|_COMMANDCOUNT|_CONSOLEINPUT|_CONSOLETITLE|_DEFAULTCOLOR|_DESKTOPWIDTH|_DISPLAYORDER|_ENVIRONCOUNT|_MESHTRIANGLE|_PALETTECOLOR|_RESIZEHEIGHT|_SCALEDHEIGHT|_SCREENEXISTS|_SHADERERROR\\$|_WINDOWHANDLE|_AUTODISPLAY|_CAMERAORTHO|_CAMERARANGE|_CONSOLEFONT|_COPYPALETTE|_DEPTHBUFFER|_DEVICEINPUT|_DIRECTIONAL|_DROPPEDFILE|_MAPTRIANGLE|_MESHTEXTURE|_MOUSEBUTTON|_PRINTSTRING|_RESIZEWIDTH|_SCALEDWIDTH|_SCREENCLICK|_SCREENIMAGE|_SCREENPRINT|_SHADERPARAM|_SNDPLAYCOPY|_SNDPLAYFILE|_CLEARCOLOR|_CLIPBOARD\\$|_CONTROLCHR|_FILEEXISTS|_FINISHDROP|_FONTHEIGHT|_FREESHADER|_FULLSCREEN|_LASTBUTTON|_MAPUNICODE|_MEMELEMENT|_MESHSHADER|_MESHVERTEX|_MOUSEINPUT|_MOUSEWHEEL|_OPENCLIENT|_PRINTIMAGE|_PRINTWIDTH|_RANDOMSEED|_SCREENHIDE|_SCREENICON|_SCREENMOVE|_SCREENSHOW|_SCROLLLOCK|_SNDOPENRAW|_SNDPLAYING|_SNDRAWDONE|_STARTSWITH|CUSTOMTYPE|IMPLEMENTS|_CONNECTED|_COPYIMAGE|_DIREXISTS|_DONTBLEND|_ERRORLINE|_FONTWIDTH|_FREEIMAGE|_FREELIGHT|_FREETIMER|_INTEGER64|_LASTWHEEL|_LOADIMAGE|_LOADMODEL|_MEMEXISTS|_MESHBEGIN|_MESHCOLOR|_MESHPLANE|_MOUSEHIDE|_MOUSEMOVE|_MOUSESHOW|_PIXELSIZE|_PRINTMODE|_SHELLHIDE|_SNDGETPOS|_SNDPAUSED|_SNDRAWLEN|_SNDSETPOS|_STARTDIR\\$|_TOGGLEBIT|RANDOMIZE|_CAPSLOCK|_CONTINUE|_DEFLATE\\$|_ENDSWITH|_EXPLICIT|_FREEFONT|_FREEMESH|_GLRENDER|_INFLATE\\$|_INSTRREV|_KEYCLEAR|_LASTAXIS|_LOADFONT|_MEMIMAGE|_MEMSOUND|_MESHCUBE|_NEWIMAGE|_OPENHOST|_PRESERVE|_PUTIMAGE|_REPLACE\\$|_RESETBIT|_SETALPHA|_SNDCLOSE|_SNDLIMIT|_SNDPAUSE|_UNSIGNED|COMMAND\\$|ENVIRON\\$|EXPLICIT|FILEATTR|FREEFILE|FUNCTION|OPTIONAL|PRESERVE|_ALPHA32|_AMBIENT|_ANDALSO|_CLEAR3D|_CONSOLE|_DEVICE\\$|_DEVICES|_DISPLAY|_FORMAT\\$|_GREEN32|_KEYDOWN|_LIGHTON|_MEMCOPY|_MEMFILL|_MEMFREE|_MESHEND|_NUMLOCK|_READBIT|_SCREENX|_SCREENY|_SNDCOPY|_SNDLOOP|_SNDOPEN|_SNDPLAY|_SNDRATE|_SNDSTOP|_STRICMP|DECLARE|DYNAMIC|EXTENDS|FINALLY|INTEGER|LIBRARY|MKDMBF\\$|MKSMBF\\$|PALETTE|RESTORE|STRING\\$|VARPTR\\$|_ARCCOT|_ARCCSC|_ARCSEC|_ASSERT|_BLUE32|_BUTTON|_CAMERA|_DRAW3D|_HEIGHT|_KEYHIT|_MEMGET|_MEMNEW|_MEMPUT|_MOUSEX|_MOUSEY|_OFFSET|_ORELSE|_RESIZE|_RGBA32|_SETBIT|_SHADER|_SMOOTH|_SNDBAL|_SNDLEN|_SNDRAW|_SNDVOL|_SOURCE|_STDERR|_STRCMP|_TITLE\\$|_TOSTR\\$|ACCESS|APPEND|BINARY|CIRCLE|COMMON|CSRLIN|CVDMBF|CVSMBF|DEFDBL|DEFINT|DEFLNG|DEFSNG|DEFSTR|DOUBLE|ELSEIF|IMPORT|INKEY\\$|INPUT\\$|LBOUND|LCASE\\$|LOCATE|LPRINT|LTRIM\\$|OPTION|OUTPUT|PRESET|RANDOM|RESUME|RETURN|RIGHT\\$|RTRIM\\$|SCREEN|SELECT|SETMEM|SHARED|SINGLE|SPACE\\$|STATIC|STRING|SYSTEM|UBOUND|UCASE\\$|UEVENT|UNLOCK|VARSEG|WINDOW|_ACOSH|_ALPHA|_ASINH|_ATAN2|_ATANH|_BLEND|_BLINK|_DELAY|_FLOAT|_GPU3D|_GREEN|_HYPOT|_JOIN\\$|_LIGHT|_LIMIT|_ORTHO|_POINT|_RED32|_REGEX|_RGB32|_ROUND|_SPLIT|_THROW|_TRIM\\$|_UCHR\\$|_UMID\\$|_VOICE|_WHEEL|_WIDTH|ALIAS|BLOAD|BSAVE|BYVAL|CATCH|CHAIN|CHDIR|CLASS|CLEAR|CLOSE|COLOR|CONST|DATE\\$|ENDIF|ERASE|ERROR|FILES|GOSUB|INPUT|INSTR|IOCTL|LEFT\\$|MKDIR|PAINT|PCOPY|POINT|PRINT|REDIM|RESET|RMDIR|SHELL|SLEEP|SOUND|STICK|STRIG|TIME\\$|TIMER|TROFF|UNTIL|USING|WHILE|WIDTH|WRITE|_ACOS|_ADSR|_ASIN|_AXIS|_BIN\\$|_BLUE|_BYTE|_CEIL|_CINP|_COSH|_COTH|_CSCH|_CWD\\$|_DEST|_DICT|_DIR\\$|_ECHO|_EXIT|_FONT|_ICON|_LIST|_MESH|_RGBA|_SECH|_SINH|_TANH|_UASC|_ULEN|_WAVE|BASE|BEEP|CALL|CASE|CDBL|CHR\\$|CINT|CLNG|CSNG|DATA|DRAW|EACH|ELSE|ENUM|EXIT|GOTO|HEX\\$|KILL|LINE|LOCK|LONG|LOOP|LPOS|LSET|MID\\$|MKD\\$|MKI\\$|MKL\\$|MKS\\$|NAME|NEXT|OCT\\$|OPEN|PEEK|PLAY|PMAP|POKE|PSET|READ|RSET|SADD|SEEK|STEP|STOP|STR\\$|SWAP|THEN|TRON|TYPE|VIEW|WAIT|WEND|_BIT|_COT|_CSC|_D2G|_D2R|_FPS|_G2D|_G2R|_IIF|_MEM|_MK\\$|_OS\\$|_R2D|_R2G|_RED|_RGB|_SEC|_SHL|_SHR|ABS|AND|ANY|ASC|ATN|CLS|COM|COS|CVD|CVI|CVL|CVS|DEF|DIM|END|EOF|EQV|ERL|ERR|EXP|FIX|FOR|FRE|GET|IMP|INP|INT|KEY|LEN|LET|LOC|LOF|LOG|MOD|NOT|OFF|OUT|PEN|POS|PUT|REM|RND|SEG|SGN|SIN|SPC|SQR|SUB|TAB|TAN|TRY|VAL|XOR|_CV|_PI|AS|DO|FN|IF|IN|IS|ON|OR|TO)(?![\\w.$%&!#~`]))([A-Za-z_][\\w.]*[%&!#$~`]*)",
          "captures": {
            "1": {
              "name": "keyword.other.as.qbasic"
            },
            "2": {
              "name": "entity.name.type.qbasic"
            }
          }
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.qbasic",
          "match": "&[Hh][0-9A-Fa-f]+[%&!#~`]*"
        },
        {
          "name": "constant.numeric.octal.qbasic",
          "match": "&[Oo][0-7]+[%&!#~`]*"
        },
        {
          "name": "constant.numeric.binary.qbasic",
          "match": "&[Bb][01]+[%&!#~`]*"
        },
        {
          "name": "constant.numeric.qbasic",
          "match": "(?<![\\w.])(?:\\d+\\.?\\d*|\\.\\d+)(?:[EeDdFf][+-]?\\d+)?[%&!#~`]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.qbasic",
          "match": "(?i)(?<![\\w.$])(?:_CONTINUE|FINALLY|ELSEIF|RESUME|RETURN|SELECT|SYSTEM|_THROW|CATCH|ENDIF|ERROR|GOSUB|UNTIL|WHILE|CALL|CASE|EACH|ELSE|EXIT|GOTO|LOOP|NEXT|STEP|STOP|THEN|WEND|END|FOR|TRY|DO|IF|IN|IS|ON|TO)(?![\\w.$%&!#~`])"
        },
        {
          "name": "keyword.operator.word.qbasic",
          "match": "(?i)(?<![\\w.$])(?:_ANDALSO|_ORELSE|AND|EQV|IMP|MOD|NOT|XOR|OR)(?![\\w.$%&!#~`])"
        },
        {
          "name": "storage.type.qbasic",
          "match": "(?i)(?<![\\w.$])(?:_INTEGER64|_UNSIGNED|INTEGER|_OFFSET|DOUBLE|SINGLE|STRING|_FLOAT|_BYTE|_DICT|_LIST|LONG|_BIT|_MEM|ANY)(?![\\w.$%&!#~`])"
        },
        {
          "name": "support.function.builtin.qbasic",
          "match": "(?i)(?<![\\w.$])(?:_CONNECTIONADDRESS|_TOTALDROPPEDFILES|_BACKGROUNDCOLOR|_CLIPBOARDIMAGE|_INCLERRORFILE\\$|_MOUSEMOVEMENTX|_MOUSEMOVEMENTY|_OPENCONNECTION|_WINDOWHASFOCUS|_DESKTOPHEIGHT|_ERRORMESSAGE\\$|_INCLERRORLINE|_MOUSEPIPEOPEN|_BUTTONCHANGE|_COMMANDCOUNT|_CONSOLEINPUT|_DEFAULTCOLOR|_DESKTOPWIDTH|_ENVIRONCOUNT|_PALETTECOLOR|_RESIZEHEIGHT|_SCALEDHEIGHT|_SCREENEXISTS|_SHADERERROR\\$|_WINDOWHANDLE|_DEVICEINPUT|_DROPPEDFILE|_MOUSEBUTTON|_RESIZEWIDTH|_SCALEDWIDTH|_SCREENIMAGE|_FILEEXISTS|_FONTHEIGHT|_LASTBUTTON|_MEMELEMENT|_MOUSEINPUT|_MOUSEWHEEL|_OPENCLIENT|_PRINTWIDTH|_SCROLLLOCK|_SNDOPENRAW|_SNDPLAYING|_STARTSWITH|_CONNECTED|_COPYIMAGE|_DIREXISTS|_ERRORLINE|_FONTWIDTH|_FREETIMER|_LASTWHEEL|_LOADIMAGE|_LOADMODEL|_MEMEXISTS|_MESHPLANE|_PIXELSIZE|_SHELLHIDE|_SNDGETPOS|_SNDPAUSED|_SNDRAWLEN|_STARTDIR\\$|_TOGGLEBIT|_CAPSLOCK|_DEFLATE\\$|_ENDSWITH|_INFLATE\\$|_INSTRREV|_LASTAXIS|_LOADFONT|_MEMIMAGE|_MEMSOUND|_MESHCUBE|_NEWIMAGE|_OPENHOST|_REPLACE\\$|_RESETBIT|COMMAND\\$|ENVIRON\\$|FILEATTR|FREEFILE|_ALPHA32|_CONSOLE|_DEVICE\\$|_DEVICES|_FORMAT\\$|_GREEN32|_KEYDOWN|_MESHEND|_NUMLOCK|_READBIT|_SCREENX|_SCREENY|_SNDCOPY|_SNDOPEN|_SNDRATE|_STRICMP|MKDMBF\\$|MKSMBF\\$|STRING\\$|VARPTR\\$|_ARCCOT|_ARCCSC|_ARCSEC|_BLUE32|_BUTTON|_HEIGHT|_KEYHIT|_MEMGET|_MEMNEW|_MOUSEX|_MOUSEY|_OFFSET|_RGBA32|_SETBIT|_SHADER|_SMOOTH|_SNDLEN|_STRCMP|_TITLE\\$|_TOSTR\\$|CSRLIN|CVDMBF|CVSMBF|INKEY\\$|INPUT\\$|LBOUND|LCASE\\$|LTRIM\\$|RIGHT\\$|RTRIM\\$|SCREEN|SETMEM|SPACE\\$|UBOUND|UCASE\\$|VARSEG|_ACOSH|_ALPHA|_ASINH|_ATAN2|_ATANH|_GPU3D|_GREEN|_HYPOT|_JOIN\\$|_LIGHT|_RED32|_REGEX|_RGB32|_ROUND|_SPLIT|_TRIM\\$|_UCHR\\$|_UMID\\$|_WHEEL|_WIDTH|INSTR|LEFT\\$|POINT|STICK|STRIG|_ACOS|_ASIN|_AXIS|_BIN\\$|_BLUE|_CEIL|_CINP|_COSH|_COTH|_CSCH|_CWD\\$|_DIR\\$|_EXIT|_MESH|_RGBA|_SECH|_SINH|_TANH|_UASC|_ULEN|CDBL|CHR\\$|CINT|CLNG|CSNG|HEX\\$|LPOS|MID\\$|MKD\\$|MKI\\$|MKL\\$|MKS\\$|OCT\\$|PEEK|PMAP|SADD|STR\\$|_COT|_CSC|_D2G|_D2R|_G2D|_G2R|_IIF|_MEM|_MK\\$|_OS\\$|_R2D|_R2G|_RED|_RGB|_SEC|_SHL|_SHR|ABS|ASC|ATN|COS|CVD|CVI|CVL|CVS|EOF|ERL|ERR|EXP|FIX|FRE|INP|INT|LEN|LOC|LOF|LOG|PEN|POS|RND|SGN|SIN|SPC|SQR|TAB|TAN|VAL|_CV|_PI)(?![\\w.$%&!#~`])"
        },
        {
          "name": "support.function.statement.qbasic",
          "match": "(?i)(?<![\\w.$])(?:_ALLOWFULLSCREEN|_ACCEPTFILEDROP|_MOUSEINPUTPIPE|_MOUSEPIPECLOSE|_CONSOLECURSOR|_CONSOLETITLE|_DISPLAYORDER|_MESHTRIANGLE|_AUTODISPLAY|_CAMERAORTHO|_CAMERARANGE|_CONSOLEFONT|_COPYPALETTE|_DEPTHBUFFER|_MAPTRIANGLE|_MESHTEXTURE|_PRINTSTRING|_SCREENCLICK|_SCREENPRINT|_SHADERPARAM|_SNDPLAYCOPY|_SNDPLAYFILE|_CLEARCOLOR|_CLIPBOARD\\$|_CONTROLCHR|_FINISHDROP|_FREESHADER|_FULLSCREEN|_MAPUNICODE|_MESHSHADER|_MESHVERTEX|_PRINTIMAGE|_RANDOMSEED|_SCREENHIDE|_SCREENICON|_SCREENMOVE|_SCREENSHOW|_SNDRAWDONE|_DONTBLEND|_FREEIMAGE|_FREELIGHT|_MESHBEGIN|_MESHCOLOR|_MOUSEHIDE|_MOUSEMOVE|_MOUSESHOW|_PRINTMODE|_SNDSETPOS|RANDOMIZE|_FREEFONT|_FREEMESH|_GLRENDER|_KEYCLEAR|_PUTIMAGE|_SETALPHA|_SNDCLOSE|_SNDLIMIT|_SNDPAUSE|_AMBIENT|_CLEAR3D|_DISPLAY|_LIGHTON|_MEMCOPY|_MEMFILL|_MEMFREE|_SNDLOOP|_SNDPLAY|_SNDSTOP|PALETTE|_ASSERT|_CAMERA|_DRAW3D|_MEMPUT|_RESIZE|_SNDBAL|_SNDRAW|_SNDVOL|_SOURCE|_STDERR|CIRCLE|LOCATE|LPRINT|OPTION|PRESET|UEVENT|UNLOCK|WINDOW|_BLEND|_BLINK|_DELAY|_LIMIT|_VOICE|BLOAD|BSAVE|CHAIN|CHDIR|CLEAR|COLOR|DATE\\$|FILES|IOCTL|MKDIR|PAINT|PCOPY|RESET|RMDIR|SHELL|SLEEP|SOUND|TIME\\$|TIMER|TROFF|WIDTH|WRITE|_ADSR|_DEST|_ECHO|_FONT|_ICON|_WAVE|BEEP|DRAW|KILL|LOCK|LSET|NAME|PLAY|POKE|PSET|READ|RSET|SEEK|SWAP|TRON|VIEW|WAIT|_FPS|CLS|COM|GET|KEY|OUT|PUT)(?![\\w.$%&!#~`])"
        },
        {
          "name": "keyword.other.qbasic",
          "match": "(?i)(?<![\\w.$])(?:_DIRECTIONAL|CUSTOMTYPE|IMPLEMENTS|_EXPLICIT|_PRESERVE|EXPLICIT|FUNCTION|OPTIONAL|PRESERVE|DECLARE|DYNAMIC|EXTENDS|LIBRARY|RESTORE|ACCESS|APPEND|BINARY|COMMON|DEFDBL|DEFINT|DEFLNG|DEFSNG|DEFSTR|IMPORT|OUTPUT|RANDOM|SHARED|STATIC|_ORTHO|_POINT|ALIAS|BYVAL|CLASS|CLOSE|CONST|ERASE|INPUT|PRINT|REDIM|USING|BASE|DATA|ENUM|LINE|OPEN|TYPE|DEF|DIM|LET|OFF|SEG|SUB|AS|FN)(?![\\w.$%&!#~`])"
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.qbasic",
          "match": "<>|<=|>=|=<|=>|><|<|>"
        },
        {
          "name": "keyword.operator.assignment.qbasic",
          "match": "[-+*/\\\\^]?="
        },
        {
          "name": "keyword.operator.arithmetic.qbasic",
          "match": "[-+*/\\\\^]"
        },
        {
          "name": "punctuation.separator.qbasic",
          "match": "[,;:]"
        }
      ]
    },
    "identifier": {
      "patterns": [
        {
          "name": "variable.other.qbasic",
          "match": "[A-Za-z_][\\w.]*[%&!#$~`]*"
        }
      ]
    }
  }
}
