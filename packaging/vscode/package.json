{
  "name": "qbnex",
  "displayName": "QBNex BASIC",
  "description": "QBasic / QB64 / QBNex language support: highlighting, snippets, diagnostics, navigation and formatting through qb-lsp, plus Run and Compile commands.",
  "version": "2.0.0",
  "publisher": "qbnex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thirawat27/QBNex"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "qbasic",
    "qb64",
    "qbnex",
    "basic"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace the compiler, language server and debug adapter paths (and the compile arguments) come only from your user settings, never from the workspace.",
      "restrictedConfigurations": [
        "qbnex.compilerPath",
        "qbnex.compileArgs",
        "qbnex.lsp.path",
        "qbnex.dap.path"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "qbasic",
        "aliases": [
          "QBNex BASIC",
          "QBasic",
          "QB64"
        ],
        "extensions": [
          ".bas",
          ".bi",
          ".bm",
          ".BAS",
          ".BI",
          ".BM"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qbasic",
        "scopeName": "source.qbasic",
        "path": "./syntaxes/qbasic.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "qbasic",
        "path": "./snippets/qbasic.json"
      }
    ],
    "breakpoints": [
      {
        "language": "qbasic"
      }
    ],
    "debuggers": [
      {
        "type": "qbnex",
        "label": "QBNex",
        "languages": [
          "qbasic"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .bas file to debug.",
                "default": "${file}"
              },
              "qir": {
                "type": "string",
                "description": "Use this QIR file instead of compiling the program with `qb --ir`."
              },
              "compiler": {
                "type": "string",
                "description": "Compiler command used to produce QIR (default: the qbnex.compilerPath setting)."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the program (default: the program's folder)."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first statement.",
                "default": false
              },
              "input": {
                "type": "string",
                "description": "File whose contents the program reads as standard input (INPUT, LINE INPUT)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "qbnex",
            "request": "launch",
            "name": "Debug QBNex program",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "QBNex: Debug program",
            "description": "Debug a .bas file on the qb-exec VM",
            "body": {
              "type": "qbnex",
              "request": "launch",
              "name": "Debug QBNex program",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],    "commands": [
      {
        "command": "qbnex.run",
        "title": "QBNex: Run",
        "icon": "$(play)"
      },
      {
        "command": "qbnex.compile",
        "title": "QBNex: Compile"
      },
      {
        "command": "qbnex.restartServer",
        "title": "QBNex: Restart Language Server"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "qbnex.run",
          "when": "editorLangId == qbasic"
        }
      ],
      "commandPalette": [
        {
          "command": "qbnex.run",
          "when": "editorLangId == qbasic"
        },
        {
          "command": "qbnex.compile",
          "when": "editorLangId == qbasic"
        }
      ]
    },
    "keybindings": [
      {
        "command": "qbnex.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == qbasic && !inDebugMode"
      },
      {
        "command": "qbnex.compile",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorLangId == qbasic"
      }
    ],
    "configuration": {
      "title": "QBNex",
      "properties": {
        "qbnex.compilerPath": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "qb",
          "description": "The QBNex compiler command (`qb` or `qbnex`, or a full path)."
        },
        "qbnex.compileArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "${file}",
            "-o",
            "${fileDirname}/${fileBasenameNoExtension}${exeExtension}"
          ],
          "description": "Arguments for QBNex: Compile. Variables: ${file}, ${fileDirname}, ${fileBasenameNoExtension}, ${exeExtension}, ${workspaceFolder}."
        },
        "qbnex.lsp.path": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "Path of the qb-lsp language server. Empty: the copy bundled in the extension's server folder, else `qb-lsp` on PATH."
        },
        "qbnex.dap.path": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "Path of the qb-dap debug adapter. Empty: the copy bundled in the extension's server folder, else `qb-dap` on PATH."
        },
        "qbnex.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the qb-lsp language server."
        }
      }
    },
    "configurationDefaults": {
      "[qbasic]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "qbnex.qbnex",
        "editor.insertSpaces": true,
        "editor.tabSize": 4
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "grammar": "node scripts/gen-grammar.mjs",
    "bundle-server": "node scripts/bundle-server.mjs",
    "test": "npm run compile && node --test test/*.test.mjs",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
