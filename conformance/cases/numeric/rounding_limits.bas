$CONSOLE:ONLY
' Float -> integer conversions at the edges (qbrt::round).
DIM l AS LONG, i64 AS _INTEGER64, u64 AS _UNSIGNED _INTEGER64, f AS _FLOAT
FOR k = 0 TO 7
    d# = -3.5 + k
    l = d#
    PRINT l;
NEXT
PRINT
s! = 16777217: l = s!: PRINT l
d# = 2147483647.4#: l = d#: PRINT l
d# = -2147483648#: l = d#: PRINT l
f = 9223372036854775807##: i64 = f: PRINT i64
f = 4611686018427387905.5##: i64 = f: PRINT i64
f = 4611686018427387906.5##: i64 = f: PRINT i64
f = 18446744073709551615##: u64 = f: PRINT u64
f = 9223372036854775808##: u64 = f: PRINT u64
f = 12345678901234567890##: u64 = f: PRINT u64
f = -1.5##: i64 = f: PRINT i64
PRINT CINT(-32768.4); CLNG(-2147483648.4#)
PRINT _ROUND(-2.5); _ROUND(1E+15 + 0.5)
SYSTEM
