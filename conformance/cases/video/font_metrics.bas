' R7: _LOADFONT through the Rust font engine. The font (Noto Sans Symbols 2, OFL 1.1,
' subset to 4 shapes; Copyright 2022 The Noto Project Authors) is written from DATA.
' Only metrics are printed: they match FreeType exactly, glyph pixels may differ (D-R7-6).
$CONSOLE
_DEST _CONSOLE
READ f$, size&
blob$ = ""
DO WHILE LEN(blob$) < size& * 2
    READ h$
    blob$ = blob$ + h$
LOOP
bytes$ = SPACE$(size&)
FOR i& = 1 TO size&
    MID$(bytes$, i&, 1) = CHR$(VAL("&H" + MID$(blob$, i& * 2 - 1, 2)))
NEXT
OPEN f$ FOR BINARY AS #1
PUT #1, , bytes$
CLOSE #1
img& = _NEWIMAGE(320, 200, 32)
FOR size = 10 TO 40 STEP 6
    FOR mono = 0 TO 1
        IF mono THEN fh& = _LOADFONT(f$, size, "MONOSPACE") ELSE fh& = _LOADFONT(f$, size)
        IF fh& <= 0 THEN PRINT "load failed"; size: END
        _DEST img&
        _FONT fh&
        a$ = CHR$(254) ' CP437 254 = U+25A0 BLACK SQUARE
        w1 = _PRINTWIDTH(a$): w2 = _PRINTWIDTH(a$ + a$ + a$)
        fw = _FONTWIDTH(fh&): fhh = _FONTHEIGHT(fh&)
        _FONT 16
        _DEST _CONSOLE
        PRINT size; mono; ": fontwidth"; fw; "fontheight"; fhh; "printwidth"; w1; w2
        _FREEFONT fh&
    NEXT
NEXT
PRINT "missing font:"; _LOADFONT("conf_no_such_font.ttf", 16)
KILL f$
SYSTEM

