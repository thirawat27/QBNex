$CONSOLE:ONLY
' R7: _LOADIMAGE through the Rust decoders. Each file is written from DATA, loaded as
' 32bpp (every pixel printed; JPEG only by size, it is lossy) and as 8bpp with (256) and
' without (257) palette remapping.
DIM SHARED nfiles AS INTEGER
READ nfiles
FOR n = 1 TO nfiles
    READ f$, size&
    blob$ = ""
    DO WHILE LEN(blob$) < size& * 2
        READ h$
        blob$ = blob$ + h$
    LOOP
    bytes$ = SPACE$(size&)
    FOR i& = 1 TO size&
        MID$(bytes$, i&, 1) = CHR$(VAL("&H" + MID$(blob$, i& * 2 - 1, 2)))
    NEXT
    OPEN f$ FOR BINARY AS #1
    PUT #1, , bytes$
    CLOSE #1
    ShowImage f$, 32
    IF RIGHT$(f$, 4) <> ".jpg" THEN
        ShowImage f$, 256
        ShowImage f$, 257
    END IF
    KILL f$
NEXT
PRINT "missing:"; _LOADIMAGE("conf_no_such_file.png", 32)
PRINT "empty name:"; _LOADIMAGE("", 32)
SYSTEM

SUB ShowImage (f$, mode)
    i& = _LOADIMAGE(f$, mode)
    IF i& = -1 THEN PRINT f$; mode; "-> -1": EXIT SUB
    w = _WIDTH(i&): h = _HEIGHT(i&)
    PRINT f$; mode; "->"; w; "x"; h
    IF RIGHT$(f$, 4) = ".jpg" THEN _FREEIMAGE i&: EXIT SUB
    _SOURCE i&
    FOR y = 0 TO h - 1
        l$ = ""
        FOR x = 0 TO w - 1
            IF mode = 32 THEN l$ = l$ + " " + HEX$(POINT(x, y)) ELSE l$ = l$ + STR$(POINT(x, y))
        NEXT
        PRINT l$
    NEXT
    IF mode = 257 THEN
        s~& = 0
        FOR c = 0 TO 255
            s~& = (s~& * 33 + _PALETTECOLOR(c, i&)) AND &HFFFFFF
        NEXT
        PRINT "palette hash"; s~&
    END IF
    _SOURCE _CONSOLE
    _FREEIMAGE i&
END SUB

