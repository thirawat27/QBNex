# Cargo build output (also holds the compiler's work folders, target/qb-temp*)
/target/
/target-agents/

# Produced by scripts/setup_* : compiler, launchers, stage-0 compiler, prebuilt QIR runner
/qb
/qbnex
/qb-stage0
*.exe
/crates/engine/exec/bin/

# Packaging output
dist/
dist-*

# Local scratch
/temp/
*.log
*.bak
*.tmp
.vscode/

# Fonts are not redistributed, except the test subsets
*.ttf
!tests/data/fonts/*.ttf

# Markdown lives in the documented places only (keeps agent/scratch notes out of the repo)
*.md
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!SECURITY.md
!TRADEMARKS.md
!CLA.md
!docs/**/*.md
!crates/**/*.md
!packaging/**/*.md
!tests/**/*.md

# Local corpus of third-party programs (see tests/corpus-local/README.md)
/tests/corpus-local/*
!/tests/corpus-local/README.md

# Agent tooling and worktrees
/.claude/
