# Default keyboard script for GUI programs without their own inputs/<id>.input.
# Presses the keys most menus/prompts accept, then closes the window so the program ends.
wait 500
key enter
wait 300
key space
wait 300
type 1
key enter
wait 300
key y
key n
wait 300
key left
key right
key up
key down
wait 500
key esc
wait 300
key q
wait 1000
close
