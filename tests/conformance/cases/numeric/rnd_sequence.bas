$CONSOLE:ONLY
' RND / RANDOMIZE state machine (qb_runtime::rnd).
PRINT RND
PRINT RND
PRINT RND(0)
PRINT RND(-1)
PRINT RND
RANDOMIZE 42
PRINT RND
RANDOMIZE USING 42
PRINT RND
RANDOMIZE USING 7.5
PRINT RND
RANDOMIZE -3
PRINT RND
PRINT RND(-0.5); RND(5); RND(-1E+30)
FOR i = 1 TO 2000: s# = s# + RND: NEXT
PRINT USING "#####.##########"; s#
SYSTEM
