$CONSOLE:ONLY
' ABS and SGN of an _UNSIGNED _INTEGER64 from 2^63 up: the value is not negative
DIM u AS _UNSIGNED _INTEGER64, z AS _UNSIGNED _INTEGER64, i AS _INTEGER64
u = 18446744073709551615
PRINT ABS(u); SGN(u)
u = 9223372036854775808
PRINT ABS(u); SGN(u)
PRINT ABS(z); SGN(z)
i = -5
PRINT ABS(i); SGN(i)
SYSTEM
