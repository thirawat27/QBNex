$CONSOLE:ONLY
' STRIG / ON STRIG, ON KEY(n) GOSUB, KEY(n) ON/OFF/STOP, _MOUSEHIDE/_MOUSESHOW
' compile and run (no joystick, no key pressed: no event, STRIG(0) = 0)
ON STRIG(0) GOSUB jb
STRIG(0) ON
STRIG ON
PRINT STRIG(0)
STRIG(0) OFF
STRIG OFF
ON KEY(1) GOSUB kh
KEY(1) ON
KEY(1) STOP
KEY(1) OFF
_MOUSEHIDE
_MOUSESHOW
PRINT "ok"
SYSTEM
jb: PRINT "joy": RETURN
kh: PRINT "key": RETURN
