$CONSOLE
SCREEN 12
_DEST _CONSOLE
t! = TIMER
DO
    k& = _KEYHIT
    IF k& THEN PRINT "hit"; k&; _KEYDOWN(100304)
    WHILE _MOUSEINPUT
        IF _MOUSEBUTTON(1) <> lastb THEN lastb = _MOUSEBUTTON(1): PRINT "btn"; lastb; _MOUSEX; _MOUSEY
        IF _MOUSEWHEEL THEN PRINT "wheel"; _MOUSEWHEEL
    WEND
    IF k& = 27 THEN EXIT DO
    _LIMIT 200
LOOP UNTIL TIMER - t! > 15
PRINT "done"
SYSTEM
