$CONSOLE:ONLY
' _MEM: _MEMNEW, _MEMFILL (byte, pattern, typed), _MEMCOPY (overlap),
' _MEMGET/_MEMPUT, _MEMEXISTS, _MEM(variable), _MEM(offset, size)
DIM m AS _MEM, v AS _MEM, w AS _MEM
m = _MEMNEW(16)
PRINT m.SIZE; m.TYPE; m.ELEMENTSIZE; _MEMEXISTS(m)
_MEMFILL m, m.OFFSET, 16, 65 AS _UNSIGNED _BYTE
_MEMFILL m, m.OFFSET + 2, 5, "xyz"
_MEMPUT m, m.OFFSET + 10, 513 AS INTEGER
_MEMCOPY m, m.OFFSET, 6 TO m, m.OFFSET + 1
FOR i = 0 TO 15: PRINT _MEMGET(m, m.OFFSET + i, _UNSIGNED _BYTE);: NEXT
PRINT
PRINT _MEMGET(m, m.OFFSET + 10, INTEGER)
DIM a(1 TO 4) AS LONG
v = _MEM(a())
PRINT v.SIZE; v.ELEMENTSIZE; v.TYPE
_MEMFILL v, v.OFFSET, v.SIZE, -1 AS LONG
_MEMPUT v, v.OFFSET + 4, 12345 AS LONG
PRINT a(1); a(2); a(3)
x# = 2.5
w = _MEM(x#)
PRINT w.SIZE; w.TYPE; _MEMGET(w, w.OFFSET, DOUBLE)
DIM n AS _MEM
n = _MEMNEW(0)
PRINT n.SIZE; n.OFFSET <> 0
SYSTEM
