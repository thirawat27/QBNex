$CONSOLE
' _BLEND, _DEFAULTCOLOR, _BACKGROUNDCOLOR, _PRINTMODE, _COPYPALETTE as functions and
' statements on images; _BLINK and _CONTROLCHR switches.
SCREEN 0
i& = _NEWIMAGE(4, 4, 32)
j& = _NEWIMAGE(4, 4, 256)
r1 = _BLEND(i&)
_DONTBLEND i&
r2 = _BLEND(i&)
_BLEND i&
r3 = _BLEND(i&)
r4 = _BLEND(j&)
_DEST i&
COLOR _RGB32(1, 2, 3), _RGB32(4, 5, 6)
d~& = _DEFAULTCOLOR
b~& = _BACKGROUNDCOLOR
d2~& = _DEFAULTCOLOR(i&)
p0 = _PRINTMODE
_PRINTMODE _KEEPBACKGROUND
p1 = _PRINTMODE
_PRINTMODE _ONLYBACKGROUND
p2 = _PRINTMODE(i&)
_PRINTMODE _FILLBACKGROUND
p3 = _PRINTMODE
_DEST j&
_PALETTECOLOR 5, _RGB32(10, 20, 30)
k& = _NEWIMAGE(2, 2, 256)
_COPYPALETTE j&, k&
c~& = _PALETTECOLOR(5, k&)
_SOURCE j&
_DEST k&
_PALETTECOLOR 6, _RGB32(7, 8, 9), j&
_COPYPALETTE
c2~& = _PALETTECOLOR(6, k&)
_DEST _CONSOLE
PRINT r1; r2; r3; r4
PRINT HEX$(d~&); " "; HEX$(b~&); " "; HEX$(d2~&)
PRINT p0; p1; p2; p3
PRINT HEX$(c~&); " "; HEX$(c2~&)
PRINT _BLINK;
_BLINK OFF
PRINT _BLINK;
_BLINK ON
PRINT _BLINK
PRINT _CONTROLCHR;
_CONTROLCHR OFF
PRINT _CONTROLCHR;
_CONTROLCHR ON
PRINT _CONTROLCHR
' a text page only fills its background; a 32-bit image has no palette
ON ERROR GOTO oops
_DEST 0
_PRINTMODE _KEEPBACKGROUND
_COPYPALETTE i&, j&
x = _BLEND(-9999)
_DEST _CONSOLE
PRINT "done"
SYSTEM
oops:
_DEST _CONSOLE
PRINT "error"; ERR
_DEST 0
RESUME NEXT
