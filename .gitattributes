crates/runtime/core/src/gfx/data/*.bin binary
tests/conformance/cases/**/*.fb text eol=lf
# QIR programs and their recorded output are compared byte for byte: never
# convert line ends on checkout (core.autocrlf on Windows runners turned
# *.expect into CRLF and failed qb-exec's corpus test).
*.qir -text
*.expect -text
# Shell scripts run under sh/bash, which reject a carriage return; cmd.exe needs
# CRLF to find labels reliably. Neither may depend on core.autocrlf.
*.sh text eol=lf
*.command text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
