# Development Dockerfile for QBNex
# This keeps the build cache and allows faster iteration

FROM ubuntu:22.04

# Install build dependencies
RUN apt-get update && apt-get install -y \
    g++ \
    make \
    libasound2-dev \
    libudev-dev \
    pkg-config \
    libx11-dev \
    libxext-dev \
    libxrandr-dev \
    libxi-dev \
    libxcursor-dev \
    curl \
    wget \
    inotify-tools \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain for the qb-runtime library (crates/qb-runtime)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

# Set working directory
WORKDIR /app

# Copy only necessary files for building
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
COPY tests/conformance/ ./tests/conformance/
COPY internal/ ./internal/
COPY compiler/ ./compiler/

# Build QBNex compiler
RUN (cd internal/c/libqb/os/lnx && rm -f libqb_setup.o && chmod +x setup_build.sh && ./setup_build.sh) && \
    (cd crates/qb-runtime/os/linux && rm -f libqb_runtime.a && sh ./setup_build.sh) && \
    (mkdir -p internal/temp && \
     cp -r internal/source/* internal/temp/ && \
     cp -r compiler/* internal/temp/ && \
     cd internal/c && \
     g++ -no-pie -w qbx.cpp \
       libqb/os/lnx/libqb_setup.o \
       ../../crates/qb-runtime/os/linux/libqb_runtime.a -lpthread -ldl -lm -lrt -lutil \
       -ludev -lasound -lpthread -ldl -lrt \
       -o ../../qb-stage0) && \
    /app/qb-stage0 /app/compiler/qbnex.bas -o /app/qb

# Make qb (and its product-name alias qbnex) available in PATH
RUN if [ -f /app/qb ]; then cp /app/qb /usr/local/bin/qb && ln -sf qb /usr/local/bin/qbnex; fi

# Set working directory for user projects
WORKDIR /project

# Default command
CMD ["bash"]
