# Development Dockerfile for QBNex (QIR pipeline)
# One stage that keeps the Rust build cache for faster rebuilds.

FROM ubuntu:22.04

# Build dependencies: Rust, plus gcc only as the system linker that Rust uses
# on Linux (no C/C++ source of QBNex is compiled)
RUN apt-get update && apt-get install -y \
    gcc \
    libasound2-dev \
    libudev-dev \
    libxkbcommon-dev \
    pkg-config \
    libx11-dev \
    libxext-dev \
    libxrandr-dev \
    libxi-dev \
    libxcursor-dev \
    curl \
    wget \
    inotify-tools \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain for the QIR runner qb-exec (crates/qb-exec)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

# Set working directory
WORKDIR /app

# Copy only what the build needs
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ ./crates/
COPY bootstrap/ ./bootstrap/
COPY compiler/ ./compiler/
COPY scripts/ ./scripts/

# Build qb-exec, pack bootstrap/qbnex.qir into qb-stage0, self-host ./qb
RUN sh ./scripts/setup_lnx.sh

# Launchers on PATH that call /app/qb by its full path, so it finds /app/crates
RUN printf '#!/bin/sh\nexec /app/qb "$@"\n' > /usr/local/bin/qb && \
    chmod +x /usr/local/bin/qb && \
    ln -sf qb /usr/local/bin/qbnex

# Set working directory for user projects
WORKDIR /project

# Default command
CMD ["bash"]